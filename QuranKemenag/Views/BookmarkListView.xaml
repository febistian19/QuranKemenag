<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuranKemenag.Views.BookmarkListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuranKemenag.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="0,0,14,0" Click="Kembali_Click">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <TextBlock Text="Semua Bookmark" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock x:Name="TxtKosong" Text="Belum ada ayat yang di-bookmark."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5"
                           HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />

                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <ItemsControl x:Name="DaftarBookmark">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding NomorSurah}" FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                    Tapped="BukaAyat_Tapped" Tag="{Binding}">
                                            <TextBlock Text="{Binding NamaSurah}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                <Run Text="Ayat " /><Run Text="{Binding NomorAyat}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                ToolTipService.ToolTip="Hapus bookmark" Tag="{Binding}" Click="HapusBookmark_Click">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>