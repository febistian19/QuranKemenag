<UserControl
    x:Class="QuranKemenag.Views.MushafPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuranKemenag.Views">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Halaman mushaf dengan bingkai gambar iluminasi — dibesarkan mengisi ruang tersedia ===== -->
        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="20,14">
            <Grid Width="640" Height="800">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,640,800" />
                </Grid.Clip>

                <!-- Layer 1: gambar bingkai iluminasi -->
                <Image Source="/Resources/Images/iluminasi.png" Stretch="Fill" />

                <!-- Layer 2: konten ayat — mengisi penuh area putih bingkai -->
                <Grid Margin="120,195,145,65">
                    <ScrollViewer Width="375" Padding="15,0,15,0"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <RichTextBlock x:Name="TeksMushaf" FontFamily="LPMQ Isep Misbah" FontSize="23" LineHeight="42"
                    TextAlignment="Justify" FlowDirection="RightToLeft" TextWrapping="Wrap" Width="345">
                            <Paragraph x:Name="ParagrafMushaf" />
                        </RichTextBlock>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- ===== Info ayat — di bawah, rata kanan bingkai ===== -->
        <Border Grid.Row="1" Background="#FFFCEA" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5"
                CornerRadius="16" Padding="18,6" HorizontalAlignment="Right" Margin="0,4,55,14">
            <TextBlock x:Name="TxtInfoBawah" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <!-- TxtNamaSurahArab tetap ada di code-behind supaya kompilasi tidak error,
             tapi tidak dirender di UI (judul dihapus sesuai permintaan) -->
        <TextBlock x:Name="TxtNamaSurahArab" Visibility="Collapsed" />
    </Grid>
</UserControl>