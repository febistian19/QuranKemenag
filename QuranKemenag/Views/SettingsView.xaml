            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="UKURAN TERJEMAHAN" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtUkuranTerjemah" Text="16px" HorizontalAlignment="Right" FontSize="11" />
                    </Grid>
                    <Slider x:Name="SliderTerjemah" Minimum="10" Maximum="28" Value="16" Margin="0,8" ValueChanged="SliderTerjemah_ValueChanged" />
                    <Border Background="{ThemeResource BackgroundBrush}" Padding="16" CornerRadius="6">
                        <TextBlock x:Name="PreviewTerjemah" Text="Dengan nama Allah Yang Maha Pengasih lagi Maha Penyayang." FontSize="16" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Download Bahasa Terjemahan" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardBorder}" Padding="0">
                <StackPanel>
                    <RadioButton GroupName="Bahasa" IsChecked="True" Style="{StaticResource LanguageRowRadio}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource KodeBahasaBadge}">
                                <TextBlock Text="ID" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource PrimaryGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Indonesia" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="Default sistem" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <Border BorderBrush="{ThemeResource BorderBrush2}" BorderThickness="0,1,0,0" />
                    <RadioButton GroupName="Bahasa" Style="{StaticResource LanguageRowRadio}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource KodeBahasaBadge}">
                                <TextBlock Text="EN" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource PrimaryGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Inggris" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="English (United States)" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                    <Border BorderBrush="{ThemeResource BorderBrush2}" BorderThickness="0,1,0,0" />
                    <RadioButton GroupName="Bahasa" Style="{StaticResource LanguageRowRadio}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource KodeBahasaBadge}">
                                <TextBlock Text="AR" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource PrimaryGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Arab" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="العربية" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>