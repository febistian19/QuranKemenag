<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuranKemenag.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuranKemenag.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="30" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="Pengaturan Tampilan" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />











            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="PILIHAN TEMA" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <Border Style="{StaticResource ThemePillGroup}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <RadioButton x:Name="RbTerang" Style="{StaticResource ThemePillRadio}" MinWidth="0" GroupName="Tema" Checked="RbTema_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="14" Margin="0,0,8,5" />
                                    <TextBlock Text="Light" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbGelap" Style="{StaticResource ThemePillRadio}" MinWidth="0" GroupName="Tema" Checked="RbTema_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE708;" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Dark" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbSistem" Style="{StaticResource ThemePillRadio}" MinWidth="0" GroupName="Tema" Checked="RbTema_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock Text="System" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
















