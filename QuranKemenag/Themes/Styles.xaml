<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== TOMBOL UTAMA (hijau) ===================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ===================== KARTU (surah, juz, bookmark) ===================== -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Tombol sekunder (abu-abu netral) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="#EEF0F1" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Badge nomor ayat (lingkaran emas) -->
    <Style x:Key="NomorBadge" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="Background" Value="#FFFCF3" />
    </Style>

    <!-- Tombol toggle (dipakai untuk "Per Ayat" / "Mushaf Per Halaman") -->
    <Style x:Key="ToggleTabButton" TargetType="ToggleButton">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Kontainer toggle group -->
    <Style x:Key="ToggleTabGroup" TargetType="Border">
        <Setter Property="Background" Value="#EEF0F1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Kartu interaktif (dipakai untuk kartu ekspor Word/PowerPoint) -->
    <Style 
        x:Key="CardBorderInteractive" TargetType="Border" BasedOn="{StaticResource CardBorder}">
    </Style>

    <!-- ===================== TOMBOL NAVIGASI SIDEBAR ===================== -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="NavMenu" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bd.Background" Value="#F0F2F3" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Bd.Background" Value="#E7F4EF" />
                                        <Setter Target="Isi.Foreground" Value="{StaticResource PrimaryGreenBrush}" />
                                        <Setter Target="Isi.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,0">
                            <ContentPresenter x:Name="Isi" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Label kategori sidebar (mis. AL-QUR'AN, PENGATURAN) -->
    <Style x:Key="NavGroupLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="20,20,0,6" />
    </Style>

</ResourceDictionary>