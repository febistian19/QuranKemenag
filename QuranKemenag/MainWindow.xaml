<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuranKemenag.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuranKemenag"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Qur'an Kemenag">

    

    <Grid RequestedTheme="Light" Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & judul aplikasi -->
                <Border Grid.Row="0" Padding="22,26,22,22" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/Images/logo-kemenag.png" Width="44" Height="44" Stretch="Uniform" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Qur'an Kemenag" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Versi Dekstop" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Menu navigasi -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" Checked="NavDashboard_Checked">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" FontSize="15" Width="24" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="AL-QUR'AN" Style="{StaticResource NavGroupLabel}" />
                    <RadioButton x:Name="NavSurah" Style="{StaticResource NavButtonStyle}" Checked="NavSurah_Checked">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="15" Width="24" />
                            <TextBlock Text="Per Surah" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavJuz" Style="{StaticResource NavButtonStyle}" Checked="NavJuz_Checked">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE736;" FontSize="15" Width="24" />
                            <TextBlock Text="Per Juz" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="PENGATURAN" Style="{StaticResource NavGroupLabel}" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Checked="NavSettings_Checked">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="15" Width="24" />
                            <TextBlock Text="Pengaturan Tampilan" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButtonStyle}" Checked="NavAbout_Checked">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="15" Width="24" />
                            <TextBlock Text="Tentang Aplikasi" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Status database di bagian bawah sidebar -->
                <Border Grid.Row="2" Margin="16,10,16,18" Padding="12,10" Background="#F5F6F7" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotStatusDb" Width="8" Height="8" Fill="#1E7145" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStatusDb" Text="Data offline siap dipakai" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= KONTEN ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="HeaderTitle" Text="Dashboard"
                           FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="28,0"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>